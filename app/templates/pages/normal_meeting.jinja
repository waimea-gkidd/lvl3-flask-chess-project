{#=====================================================
  Normal Meetings home (Rami only)
  - Start a new meeting, a card for every meeting
    (newest first), each one opens the meeting
    copy of tournament_home.jinja
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block title %}
    - Normal Meetings
{% endblock %}


{% block content %}

    <h2>Normal Meetings</h2>

    {# forms.md type="date" gives a calendar #}
    <form method="post" action="/meeting/new">
        <label>
            Date
            <input name="date" type="date" required>
        </label>
        <button>Start New Meeting</button>
    </form>

    <section id="cards">
{# Creatures project same cards as tournament_home.jinja #}
        {% for meeting in meetings %}

            <div class="card">
            {#jinja.md#}
                <h3>{{ meeting.date | format_date }}</h3>
            {#crud.md#}
                <a href="/meeting/{{ meeting.id }}">View Meeting</a>
            </div>

        {% else %}

            <p>No meetings yet</p>

        {% endfor %}

    </section>

{% endblock %}