{#=====================================================
  Teams Tournament home
  - Everyone: current standings route, card for every
    session (newest first), each one opens the session details
  - Rami only: start a new session, edit (coming soon)
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block title %}
    - Teams Tournament
{% endblock %}


{% block content %}

    <h2>Teams Tournament</h2>

    <a href="/tournament/standings" role="button">Current Standings</a>

            {#admin actions for begining a session#}

    {% if session.logged_in %}
        <form method="post" action="/tournament/new">
            <button>Start New Session</button>
        </form>
    {% endif %}

            {#session cards#}

    <section id="cards">

        {% for tournament in tournaments %}

            <div class="card">
                <h3>Semester {{ tournament.semester_id }}, Phase {{ tournament.phase_id }}</h3>
            
            {#only show date if it exists#}

                {% if tournament.date %}
                    <p>{{ tournament.date }}</p>
                {% endif %}
            {#jinja.ma saved result = shows score + winner#}

                {% if tournament.winning_team %}
                    <p>Team A {{ tournament.team_a_score }} - {{ tournament.team_b_score }} Team B</p>

                    {% if tournament.winning_team == "Draw" %}
                        <p>Draw</p>
                    {% else %}
                        <p>Team {{ tournament.winning_team }} won</p>
                    {% endif %}
                {% else %}
                    <p>No result yet</p>
                {% endif %}
            {#crud.md#}

                <a href="/tournament/{{ tournament.id }}">View Session</a>
            </div>

        {% else %}

            <p>No sessions yet</p>

        {% endfor %}

    </section>

{% endblock %}