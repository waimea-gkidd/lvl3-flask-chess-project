{#=====================================================
  TT Teams page
  - Attending players with a toggle for Team A / Team B
  same setup as attendance toggle
=====================================================#}

{% extends 'pages/tournament_base.jinja' %}


{% block title %}
    - TT Teams
{% endblock %}

{#Scrollable list from attendace.jinja#}
{% block heading %}TT Teams{% endblock %}


{% block tournament_content %}

    <section id="members">
        <h3>Players</h3>

        {# toggle_team #}
        {# members row id goes in the url (routes.md) #}
        {% for member in members %}
            <form method="post" action="/tournament/{{ tournament_id }}/team/{{ member.id }}">

                <span>{{ member.name }}</span>
{#jinja.md buttons show current teams#}
                {% if member.team == "A" %}
                    <button>Team A</button>
                {% else %}
                    <button>Team B</button>
                {% endif %}
            </form>
        {% else %}
            <p>No one is attending yet</p>
        {% endfor %}
    </section>

    <a href="/tournament/{{ tournament_id }}/result" role="button">Confirm Teams</a>
    <a href="/tournament/{{ tournament_id }}/attendance" role="button">Back</a>

{% endblock %}