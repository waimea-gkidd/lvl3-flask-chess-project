{#=====================================================
  TT Attendance page
  - Search, club member list with attendance toggles,
    add player, and on to Setup Teams
=====================================================#}

{% extends 'pages/tournament_base.jinja' %}


{% block title %}
    - TT Attendance
{% endblock %}


{% block heading %}TT Attendance{% endblock %}


{% block tournament_content %}
    {# routes.md #}
    {# crud.md #}

    <form method="get" action="/tournament/{{ tournament_id }}/attendance">
        <label>
            Search Player
            <input name="q" type="text" value="{{ search }}">
        </label>
        <button>Search</button>
    </form>

    {# Scrollable list #}

    <section id="members">
        <h3>Members</h3>

        {# One form per player add button for team/attendance next to each player#}
        {# player id goes in the url instead of a hidden input (routes.md) #}
        {% for player in players %}
            <form method="post" action="/tournament/{{ tournament_id }}/attendance/{{ player.id }}">

                <span>{{ player.name }}</span>

                {% if player.id in attending_ids %}
                    <button>Attending</button>
                {% else %}
                    <button>Not attending</button>
                {% endif %}
            </form>
        {% else %}
            {# if player does not exist #}

            <p>No players found</p>
        {% endfor %}
    </section>
    {# forms.md #}

    <form method="post" action="/tournament/{{ tournament_id }}/player">
        <label>
            New Player Name
            <input name="name" type="text" required>
        </label>
        <button>Add Player</button>
    </form>

    {# link to teams, same as the done button on NM #}
    <a href="/tournament/{{ tournament_id }}/teams" role="button">Setup Teams</a>

{% endblock %}