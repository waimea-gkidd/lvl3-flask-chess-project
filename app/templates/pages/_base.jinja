{#=====================================================
  Base template
  - Used as the basis of all pages
=====================================================#}

<!DOCTYPE html>

<html lang="en" data-theme="light">

<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">

	<title>Chess In Nelson {% block title %}{% endblock %}</title>

    <link rel="icon" href="/static/images/note.svg">

    <script src="/static/js/utils.js"></script>

    <link rel="stylesheet" href="/static/css/reset.css">
    <link rel="stylesheet" href="/static/css/messages.css">
    <link rel="stylesheet" href="/static/css/styles.css">
</head>

<body>

    <header>
        <a href="/"> 
       {#CIN logo is linked to the base template so it appears on every page.#}

            <img src="/static/images/CIN_logo.png" alt="Chess in Nelson" class="logo">
        </a>
            {#Nav = Auth.md login requirements for certain pages.#}
                <nav>
            {% if session.logged_in %}
                Welcome, {{ session.user.forename }}!
                <a href="/">Home</a>
                <a href="/tournament">Teams Tournament</a>
                <a href="/meeting">Normal Meetings</a>
                <a href="/logout">Logout</a>
            {% else %}
                <a href="/">Home</a>
                <a href="/tournament">Teams Tournament</a>
                <a href="/login">Login</a>
            {% endif %}
        </nav>
    </header>

    {# Show flash messages from any previous sessions. Not used so well so far #}
    {% include "partials/messages.jinja" %}

    <main>
            {#this is where the content of each page will be going#}

        {% block content %}
        {% endblock %}

    </main>

</body>

</html>