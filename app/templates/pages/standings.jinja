{#=====================================================
  Current Standings page
  - This semester's points, highest first (public)
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block title %}
    - Standings
{% endblock %}


{% block content %}

    <h2>Semester {{ semester }} Standings</h2>
 
            {#jinja.md for's and else's cover crashing from no one having points yet. 
            Otherwise = crash loop#}

    {% for player in standings %}
        <p>{{ loop.index }}. {{ player.name }} - {{ player.total }} points</p>
    {% else %}
        <p>No points yet</p>
    {% endfor %}
    {# routes.md a link for every semester so far #}
{% if current %}
    {% for number in range(1, current + 1) %}
        <a href="/tournament/standings?semester={{ number }}">Semester {{ number }}</a>
    {% endfor %}
{% endif %}
    <a href="/tournament" role="button">Back</a>

{% endblock %}