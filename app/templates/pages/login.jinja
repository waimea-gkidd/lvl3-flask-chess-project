{#=====================================================
  Sign In page
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>Welcome Back!</h2>
    <p>Sign in to continue</p>

    <form method="post" action="/login">
        <label>
            Email/Username
            <input name="username" type="text" required>
        </label>

        <label>
            Password
            <input name="password" type="password" required>
        </label>

        <button>Sign in</button>
    </form>

{% endblock %}