{#=====================================================
  Tournament base template
  - Extends _base.jinja and adds the shared tournament
    header. All tournament pages extend this.
  - adds semester x phase y to the header
  - might seem like a waste to a superior coder, 
  but this makes it easier for me otherwise I am doing 
  this and whatever changes I add on every page. 
  I am not a superior genius coder, so I will do it this way.
=====================================================#}

{% extends 'pages/_base.jinja' %}


{% block content %}

    <h2>{% block heading %}{% endblock %}</h2>
    <p>Semester {{ tt_semester }}, Phase {{ tt_phase }}</p>

    {% block tournament_content %}
    {% endblock %}

{% endblock %}